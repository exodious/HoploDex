{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main HoploDex web view (named by webview: a window's capabilities reach every web view in it, including the PDF surface)",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "dialog:default",
    "allow-get-chooser-state",
    "allow-create-database",
    "allow-open-database",
    "allow-close-database",
    "allow-quit-application",
    "allow-remove-recent-database",
    "allow-locate-database",
    "allow-get-database-status",
    "allow-dismiss-note",
    "allow-update-backup-settings",
    "allow-skip-backup",
    "allow-update-lock-settings",
    "allow-lock-database",
    "allow-get-document-opening",
    "allow-set-document-opening",
    "allow-stage-pending-changes",
    "allow-resolve-pending-changes",
    "allow-note-activity",
    "allow-set-idle-paused",
    "allow-save-passphrase",
    "allow-forget-saved-passphrase",
    "allow-list-backups",
    "allow-restore-backup",
    "allow-delete-all-backups",
    "allow-change-passphrase",
    "allow-create-firearm",
    "allow-update-firearm",
    "allow-dispose-firearm",
    "allow-reverse-disposition",
    "allow-delete-firearm",
    "allow-get-firearm",
    "allow-list-firearms",
    "allow-create-accessory",
    "allow-update-accessory",
    "allow-get-accessory",
    "allow-list-accessories",
    "allow-dispose-accessory",
    "allow-reverse-accessory-disposition",
    "allow-delete-accessory",
    "allow-mount-record",
    "allow-list-mount-candidates",
    "allow-list-accessory-kinds",
    "allow-suggest-entries",
    "allow-settle-entry",
    "allow-list-action-types",
    "allow-list-firearm-types",
    "allow-list-registration-classes",
    "allow-list-insurance-policies",
    "allow-create-insurance-policy",
    "allow-update-insurance-policy",
    "allow-get-policy-deletion-impact",
    "allow-delete-insurance-policy",
    "allow-assign-firearm-coverage",
    "allow-assign-accessory-coverage",
    "allow-get-value-summary",
    "allow-list-photos",
    "allow-add-photo",
    "allow-add-photo-from-path",
    "allow-get-photo-thumbnail",
    "allow-get-photo-original",
    "allow-set-thumbnail-photo",
    "allow-delete-photo",
    "allow-list-document-types",
    "allow-list-documents",
    "allow-add-document",
    "allow-add-document-from-path",
    "allow-open-document",
    "allow-delete-document",
    "allow-open-preview",
    "allow-close-preview",
    "allow-set-preview-bounds",
    "allow-focus-preview",
    "allow-render-preview-page",
    "allow-get-export-scope",
    "allow-export-collection",
    "allow-import-collection",
    "allow-resolve-import-conflicts"
  ]
}
