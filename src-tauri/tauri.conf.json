{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HoploDex",
  "version": "0.1.0",
  "identifier": "io.github.exodious.HoploDex",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "rpm": {
        "depends": [
          "libcrypto.so.3()(64bit)",
          "libjavascriptcoregtk-4.1.so.0()(64bit)",
          "libsoup-3.0.so.0()(64bit)",
          "libgdk-3.so.0()(64bit)",
          "libgdk_pixbuf-2.0.so.0()(64bit)",
          "libcairo.so.2()(64bit)",
          "libgio-2.0.so.0()(64bit)",
          "libgobject-2.0.so.0()(64bit)",
          "libglib-2.0.so.0()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libgcc_s.so.1()(64bit)",
          "libm.so.6()(64bit)",
          "libc.so.6()(64bit)",
          "libc.so.6(GLIBC_2.39)(64bit)",
          "xdg-utils"
        ]
      },
      "deb": {
        "depends": [
          "libssl3t64 (>= 3.0.0)",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0 (>= 3.0.3)",
          "libgtk-3-0t64 (>= 3.21.5)",
          "libgdk-pixbuf-2.0-0 (>= 2.36.9)",
          "libcairo2 (>= 1.10.0)",
          "libglib2.0-0t64 (>= 2.66.0)",
          "libdbus-1-3 (>= 1.9.14)",
          "libgcc-s1 (>= 4.2)",
          "libc6 (>= 2.39)",
          "libwebkit2gtk-4.1-0 (>= 2.41.90)",
          "xdg-utils"
        ],
        "files": {
          "/etc/apport/blacklist.d/hoplodex": "packaging/apport-ignore"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "26.0",
      "signingIdentity": "-",
      "hardenedRuntime": true
    }
  }
}
